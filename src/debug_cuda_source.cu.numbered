 2864: 
 2865: __device__ double Node::compZCoord(int k) const {
 2866:    // Computes the z coordinate at level k.
 2867:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2868:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2869:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2870:    // used 
 2871: 
 2872:    assert(k >= 0 && k < nvrt && "ZCOOR: invalid level\n");
 2873:    
 2874:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2875: 
 2876:    if (isDry2()) return 0.0;  // XXXX I used to return 0.0
 2877: 
 2878:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2879: 
 2880:    if constexpr(ivcor == 2) {
 2881: 
 2882:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2883:       const double h_c = mesh->h_c;
 2884:       const double theta_f = mesh->theta_f;
 2885:       const double sinh_theta_f = mesh->sinh_theta_f;
 2886: 
 2887: 
 2888:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2889:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2890:       // once per time step/node.
 2891:       // CHECK: updateZCoordData
 2892: 
 2893:       //  To simplify comparisons, I define index versions of count variables.
 2894:       if      (k == ivrt)     return eta2; 
 2895:       else if (k == izlev)    return -hmod2;
 2896:       else if (k == kb)       return -depth;
 2897:       else if (k < izlev)     return mesh->ztot[k];
 2898:       else if (k > izlev) {
 2899:          const int ksig = k - izlev;
 2900: 
 2901:          if (hmod2 <= h_c) {
 2902:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2903: 
 2904:          } 
 2905:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 2906:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2907:             assert(false && "ZCOOR: invalid h_c\n");
 2908:          } 
 2909:          else {
 2910:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2911:                    h_c * mesh->sigma[ksig] + 
 2912:                    (hmod2 - h_c) * mesh->cs[ksig];
 2913:          }
 2914:       } else { 
 2915:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2916:       }
 2917: 
 2918:    }
 2919:    else if constexpr(ivcor == 1) {
 2920:       if (k == kb) return -depth;
 2921:       else if (k == nvrt-1) return eta2;
 2922:       else if (k > kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2923:    }
 2924:    
 2925:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2926:    return 0.0;
 2927: }
 2928: 
 2929: 
 2930: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 2931:    // Computes the bottom drag Cd based on the selected nchi
 2932: 
 2933:    if constexpr(nchi == 0) {
 2934:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 2935:       Cd = drag;  // Read from drag file
 2936: 
 2937:    } else if constexpr(nchi == 1) {
 2938:       // 
 2939: 
 2940:       bool ltmp = false; // for WBL iteration
 2941: 
 2942:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2943:       if (isDry || (rough == 0.0)) {
 2944:          Cd = 0.0;
 2945: 
 2946:       } else { //roughness >0 
 2947:          
 2948:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 2949: 
 2950:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 2951: 
 2952:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 2953: 
 2954:       } // if rough
 2955: 
 2956:    } else if constexpr(nchi == -1) {
 2957:    // Manning 
 2958:  
 2959:       const double htot = max(hmin_man, htot2()); 
 2960:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 2961: 
 2962:    } else {
 2963:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 2964:       
 2965:    } // if nchi
 2966: 
 2967: }
 2968: 
 2969: 
 2970: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2971:    // Checks if a side in on the boundary
 2972:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2973: 
 2974:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2975:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2976: 
 2977:    // Indices of the nodes that form the side
 2978:    const int n1 = side.n1->idx;
 2979:    const int n2 = side.n2->idx;
 2980:    isLand = false;
 2981:    
 2982: 
 2983:    // Check if the side is on a land boundary
 2984:    for (int i = 0; i < nland; i++) {
 2985:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2986:          // Consecutive nodes in the land boundary segment
 2987:          const int b1 = ilnd[i + j*nland];
 2988:          const int b2 = ilnd[i + (j + 1)*nland];
 2989: 
 2990:          assert(b1 != -1 && b2 != -1);
 2991: 
 2992:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2993:             
 2994:             isLand = true;
 2995:             return i;
 2996:          }
 2997:       }
 2998:    }
 2999: 
 3000:    // Check if the side is on an open boundary
 3001:    for (int i = 0; i < nope; i++) {
 3002:       for (int j = 0; j < nond[i] - 1; j++) {
 3003:          // Consecutive nodes in the open boundary segment
 3004:          const int b1 = iond[i + j*nope];
 3005:          const int b2 = iond[i + (j + 1)*nope];
 3006: 
 3007:          assert(b1 != -1 && b2 != -1);
 3008: 
 3009:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3010:             isLand = false;
 3011:             return i;
 3012:          }
 3013:       }
 3014:    }
 3015: 
 3016:    return -1;
 3017: }
 3018: 
 3019: 
 3020: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3021:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3022:                                     double *wind_rotate_angle, 
 3023:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3024:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3025:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3026:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3027:                                     double *drag, double *roughness, double *rmanning) {
 3028: 
 3029:    NODE(pnode);  
 3030:    const int i = idx_node;
 3031:    Node &node(*pnode);
 3032: 
 3033:    node.idx = i;
 3034: 
 3035:    const int idxNodeStart = nodeNeighNodesStart[i];
 3036:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3037:    node.numNodes = idxNodeEnd - idxNodeStart;
 3038:    node.nodes = nodeNeighNodes + idxNodeStart;
 3039:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3040: 
 3041: 
 3042: 
 3043:    const int idxElemStart = nodeNeighElemsStart[i];
 3044:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3045:    node.numElements = idxElemEnd - idxElemStart;
 3046:    node.elements = nodeNeighElems + idxElemStart;
 3047: 
 3048: 
 3049:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3050:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3051:       const int partNode = localNodePart[idxNodeGlobal]; 
 3052:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3053: 
 3054:       Node *node_ptr = nodes[partNode] + idxNode;
 3055:       
 3056:       nodeNeighNodes[idx] = node_ptr;
 3057:    }
 3058: 
 3059: 
 3060:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3061:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3062:       const int partElem = localElemPart[idxElemGlobal];
 3063:       const int idxElem  = localElemIndices[idxElemGlobal];
 3064: 
 3065:       Element *elem_ptr = elems[partElem] + idxElem;
 3066: 
 3067:       nodeNeighElems[idx] = elem_ptr;
 3068:    }      
 3069: 
 3070:    node.wind_angle = wind_rotate_angle[i];
 3071: 
 3072: 
 3073:    node.p.x   = node_coords[i * 3];
 3074:    node.p.y   = node_coords[i * 3 + 1];
 3075:    node.depth = node_coords[i * 3 + 2];
 3076: 
 3077:    if (use_ll) {
 3078:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3079:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3080:    }
 3081: 
 3082: 
 3083:    node.numSides = 0;
 3084: 
 3085:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3086:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3087:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3088:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3089:    else assert(false && "populateNodes: selected nchi not implemented.");
 3090:    
 3091:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3092:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3093:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3094: 
 3095:    
 3096:    // Links the node to the boundary information
 3097:    if (isbnd[i] >= 0) {
 3098:      
 3099:       // Get the index of the node boundary
 3100:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3101: 
 3102:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3103:       node.nodeBnd->node = &node;
 3104: 
 3105:       node.nodeBnd->sideBnd1 = nullptr;
 3106:       node.nodeBnd->sideBnd2 = nullptr;
 3107: 
 3108:       if (isbnd[i]>=0) {
 3109: 
 3110:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3111:          
 3112:          node.nodeBnd->segment->ifltype = 3 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3113:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3114: 
 3115:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3116:          node.nodeBnd->segment->clen  = nan("1");
 3117:          node.nodeBnd->segment->carea = nan("1");
 3118: 
 3119:       }
 3120:    } else {
 3121: 
 3122:       node.nodeBnd = nullptr; // For internal nodes
 3123: 
 3124:       if (isbnd[i] == landSegment) {
 3125:          node.nodeBnd = &landBoundaryNode;
 3126:          node.nodeBnd->segment = &landBoundarySegment;
 3127:       }
 3128:       
 3129:    }
 3130:    
 3131:    // XXXX GAUSSIAN HILL VELOCITIES
 3132: #ifdef GAUSSIAN_HILL_VELOCITIES
 3133:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3134:       constexpr double rot_per = 3000.0;
 3135:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3136:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3137:    // XXXXX
 3138: #endif
 3139: 
 3140: }
 3141: 
 3142: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3143:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3144:                                     double *wind_rotate_angle,   
 3145:                                     int *isdel, int *isidenode, int *isbnd,
 3146:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3147:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3148:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3149:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3150:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3151:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3152:                                     double *drag, double *roughness) {
 3153: 
 3154: 
 3155:    SIDE(pside);
 3156:    Side &side(*pside);
 3157:    const int i = idx_side;
 3158: 
 3159:    side.idx = i;  
 3160:    
 3161:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3162:    const double fc   = 2.0*omega_e*sin(sfea0);
 3163:    const double beta = 2.0*omega_e*cos(sfea0);
 3164: 
 3165:    // finding the pointer to the nodes that form the side
 3166:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3167:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3168: 
 3169:    const int locidx_n1 = localNodeIndices[idx_n1];
 3170:    const int locidx_n2 = localNodeIndices[idx_n2];
 3171:    const int part_n1 =   localNodePart[idx_n1];
 3172:    const int part_n2 =   localNodePart[idx_n2];
 3173: 
 3174:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3175:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3176: 
 3177:    // Counts the number of sides connected to each node
 3178:    side.n1->numSides++;
 3179:    side.n2->numSides++;
 3180: 
 3181:    // Normal, unitary vector to the side
 3182:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3183:    side.n = normalize(side.n);
 3184: 
 3185:    // Side boundary type
 3186:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3187:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3188: 
 3189:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3190:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3191:    {
 3192:       bool isLand = false;
 3193:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3194:       
 3195:       if (isbs > -1) {
 3196:          // assert(isLand || isbs>=0);
 3197:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3198: 
 3199:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3200: 
 3201:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3202:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3203: 
 3204:          assert (isLand == side.sideBnd->segment->isLand);
 3205: 
 3206:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3207:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3208:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3209: 
 3210:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3211:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3212:          
 3213:          side.sideBnd->side = &side;
 3214: 
 3215:       }
 3216:       else {
 3217:          side.sideBnd = nullptr;
 3218:       }
 3219:    }
 3220:    else 
 3221:    {
 3222:       side.sideBnd = nullptr;
 3223:    }
 3224: 
 3225: 
 3226:    // finding the pointer to the elements that share the side
 3227:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3228:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3229: 
 3230:    if (idx_e1 > -1) {
 3231:       const int locidx_e1 = localElemIndices[idx_e1];
 3232:       const int part_e1 =  localElemPart[idx_e1];
 3233:       side.elems[0] = elems[part_e1] + locidx_e1;
 3234: 
 3235:    }
 3236:    else {
 3237:       side.elems[0] = nullptr;
 3238:    }
 3239: 
 3240:    if (idx_e2 > -1) {
 3241:       const int locidx_e2 = localElemIndices[idx_e2];
 3242:       const int part_e2 =  localElemPart[idx_e2];
 3243:       side.elems[1] = elems[part_e2] + locidx_e2;
 3244:    }
 3245:    else {
 3246:       side.elems[1] = nullptr;
 3247:    }
 3248: 
 3249:    // Compute the center of the side
 3250:    side.center = 0.5*(side.n1->p + side.n2->p);
 3251: 
 3252:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3253:    side.shapiro = shapiro0;
 3254: 
 3255: #ifdef GAUSSIAN_HILL_VELOCITIES
 3256: // XXXX
 3257: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3258: constexpr double rot_per=3000.0;
 3259: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3260: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3261: // XXXXX      
 3262: #endif
 3263:    // Compute the z level at the center of the side
 3264:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3265:    
 3266:    // Compute the length of the side
 3267:    const Vector2 vLen = side.n2->p - side.n1->p;
 3268:    side.len = sqrt(dot(vLen, vLen));
 3269: 
 3270: 
 3271:    // Compute the Coriolis coefficient
 3272: 
 3273:    if constexpr(ncor == -1 || ncor == 0) {
 3274:       side.coriolis = coricoef;
 3275:    }
 3276:    else {
 3277:       const double sphi = side.lat();  // Latitude at the center of the side
 3278: 
 3279: // XXXXXX ERROR WHEN use_ll is false??????
 3280:       if constexpr(ics == 1) {
 3281:          // XXXXXXX
 3282:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3283:       }
 3284:       else {
 3285:          side.coriolis = 2.0*omega_e*sin(sphi);
 3286:       }
 3287: 
 3288:    }
 3289: }
 3290: 
 3291: 
 3292: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3293:    double *node_coords, double *node_coords_ll, bool use_ll,
 3294:    double *wind_rotate_angle,   
 3295:    int *isdel, int *isidenode, int *isbnd,
 3296:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3297:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3298:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3299:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3300:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3301:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3302:    double *drag, double *roughness) {
 3303: 
 3304:    ELEM(pelem);
 3305:    Element &elem(*pelem);
 3306:    const int i = idx_elem;
 3307: 
 3308:    elem.idx = i;
 3309: 
 3310:    for (int j = 0; j < i34[i]; j++) {
 3311:       const int idxNode = elnode[i*4 + j];  
 3312:       const int idxSide = elside[i*4 + j];
 3313:       
 3314:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3315:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3316: 
 3317:       // Find the neighboring element  
 3318:       if (elem.sides[j]->elems[0] == &elem) {
 3319:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3320:       }
 3321:       else {
 3322:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3323:       }
 3324:       
 3325:    }
 3326: 
 3327:    elem.i34 = i34[i];
 3328: 
 3329:    // Compute the barycenter of the element and its depth
 3330:    elem.center = {0.0, 0.0};
 3331:    elem.depth = 0.0;
 3332:    for (int j = 0; j < i34[i]; j++) {
 3333: 
 3334:       elem.center += elem.nodes[j]->p/i34[i];
 3335:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3336:    }
 3337: 
 3338: 
 3339:    
 3340:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3341:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3342: 
 3343:    elem.area = elem.computeSignedArea(); 
 3344:    elem.radius = sqrt(elem.area)/pi; 
 3345:    
 3346:    // Determines which way the normal vector to each side is oriented.
 3347:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3348:    for (int j = 0; j < i34[i]; j++)  
 3349:    {
 3350:       if (elem.sides[j]->elems[0] == &elem) {
 3351:          elem.ssign[j] =  1.0;
 3352:       }
 3353:       else {
 3354:          elem.ssign[j] = -1.0;
 3355:       }
 3356: 
 3357:    }
 3358: 
 3359:    // Derivatives of shape functions
 3360:    //  For ics=2, this is done inside element/ll frame XXX
 3361:    //  For quads, the derivative is evaluated at centroid
 3362:    for (int j = 0; j < elem.i34; j++) {
 3363:       const double area = elem.area;
 3364:       const int id2 = elem.nxq(1 + j);
 3365:       const int id3 = elem.nxq(2 + j);
 3366:       const int id4 = elem.nxq(3 + j);
 3367:       if (elem.isTri()) {
 3368:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3369:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3370:          // da1/dx = (y1 - y2)/(2*area)
 3371:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3372:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3373:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3374:       }
 3375:       else  { // Quad; evaluate at centroid
 3376:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3377:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3378:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3379:       } // if Tri
 3380: 
 3381:    } // for j   
 3382:    
 3383:    
 3384: 
 3385: }
 3386: 
 3387: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3388:                                             double *emo, double *efa, 
 3389:                                             double *umo, double *ufa, 
 3390:                                             double *vmo, double *vfa) {
 3391: 
 3392: 
 3393:    NODE_BND(nodeBnd);
 3394:    const int idx = idx_node_bnd;    
 3395: 
 3396:    nodeBnd->idx = idx;
 3397: 
 3398:    // Need to find the segment index and the index of the node on the segment
 3399:    int idxNode = -1;
 3400:    int iseg, i;
 3401:    for (iseg = 0; iseg < nope; iseg++) {
 3402:       // for each segment...
 3403:       for (i = 0; i < nond[iseg]; i++) {
 3404:          idxNode = iond[iseg + i*nope];
 3405:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3406:          
 3407:       }
 3408:    }
 3409: 
 3410:    assert(iseg < nope && "iseg is out of bounds");
 3411: 
 3412: found: // Jumped here when the node was found
 3413: 
 3414:    nodeBnd->isEssentialBC = true;
 3415:    nodeBnd->elbc = 0.0;
 3416: 
 3417:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3418: 
 3419:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3420:       nodeBnd->efa[jfr] = efa[idx2];
 3421:       nodeBnd->emo[jfr] = emo[idx2];
 3422:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3423:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3424: 
 3425:    }
 3426:         
 3427: 
 3428: }
 3429: 
 3430: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3431:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3432:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3433:                 int *isdel, int *isidenode, int *isbnd,
 3434:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3435:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3436:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3437:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3438:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3439:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3440:                 double *drag, double *roughness,
 3441:                 double *emo, double *efa, 
 3442:                 double *umo, double *ufa, 
 3443:                 double *vmo, double *vfa) {
 3444: 
 3445:    printf("Populating mesh for partition %d\n", partNum);
 3446: 
 3447:    // XXXXXX THIS function does almost nothing. 
 3448: 
 3449:    nbs = *sharedIdxSideBoundary + 1;
 3450:    nbp = *sharedIdxNodeBoundary + 1;
 3451: 
 3452:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3453: 
 3454: }
 3455: 
 3456: 
 3457: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3458:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3459:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3460: 
 3461: 
 3462:    NODE(node1);
 3463: 
 3464:    node1->clearMatrixRow();
 3465:    node1->qel = 0.0;
 3466: 
 3467:    // THIS IS FOR STRUCTURES XXX
 3468:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3469: 
 3470:    
 3471:    for (int j=0; j<node1->numElements; j++) {
 3472:       // For each element connected to the node...
 3473: 
 3474:       Element *elem = node1->elements[j];
 3475: 
 3476: 
 3477: 
 3478:       // Compute the average gravity
 3479:       const double grav3 = elem->mean(&Node::grav2);
 3480: 
 3481:       // Look at the documentation for the description of the terms in the following integrals
 3482: 
 3483:       // Integral I_1 
 3484:       // \bar{\breve{H}} 
 3485:       const double hhatb = elem->mean(&Side::hhat);        
 3486: 
 3487:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3488: 
 3489:       const int id1 = elem->nodeLocalIdx(node1); 
 3490:       const double area = elem->area;
 3491: 
 3492:       if (elem->isTri()) {
 3493: 
 3494:          // To clarify the notation in this section: 
 3495:          //   i stands for the node under consideration (node1)
 3496:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3497:          const int id2 = elem->nxq(1 + id1);
 3498:          const int id3 = elem->nxq(2 + id1);
 3499:          Node *node2 = elem->nodes[id2];
 3500:          Node *node3 = elem->nodes[id3];
 3501: 
 3502:          const Point2 x1 = node1->p;
 3503:          const Point2 x2 = node2->p;
 3504:          const Point2 x3 = node3->p;
 3505: 
 3506:          // integral of phi_i*phi_j
 3507:          const double ipp_ii = (1.0/6.0 )*area;
 3508:          const double ipp_ij = (1.0/12.0)*area;
 3509:          const double ipp_ik = (1.0/12.0)*area;
 3510: 
 3511:          // integral of [(grad phi_i) * (grad phi_j)]
 3512:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3513:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3514:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3515: 
 3516:          // Computes the different components of integral I_1 of each node with respect to node i.
 3517:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3518:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3519:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3520: 
 3521:          node1->addToSparseMatrix(node1, I1_ii);
 3522:          node1->addToSparseMatrix(node2, I1_ij); 
 3523:          node1->addToSparseMatrix(node3, I1_ik);
 3524: 
 3525:       }
 3526:       else { // Quad
 3527:          // XXX IMPLEMENT THIS
 3528:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3529: 
 3530:          // To clarify the notation in this section: 
 3531:          //   i stands for the node under consideration (node1)
 3532:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3533:          const int id2 = elem->nxq(1 + id1);
 3534:          const int id3 = elem->nxq(2 + id1);
 3535:          const int id4 = elem->nxq(3 + id1);
 3536:          Node *node2 = elem->nodes[id2];
 3537:          Node *node3 = elem->nodes[id3];
 3538:          Node *node4 = elem->nodes[id4];         
 3539: 
 3540:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3541:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3542:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3543:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3544:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3545: 
 3546:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3547:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3548:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3549:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3550:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3551: 
 3552:          // Computes the different components of integral I_1 of each node with respect to node i.
 3553:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3554:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3555:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3556:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3557: 
 3558:          node1->addToSparseMatrix(node1, I1_ii);
 3559:          node1->addToSparseMatrix(node2, I1_ij); 
 3560:          node1->addToSparseMatrix(node3, I1_ik);
 3561:          node1->addToSparseMatrix(node4, I1_il);
 3562:   
 3563:       } 
 3564: 
 3565:  
 3566:       // Integral I_4
 3567:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3568:       // Where
 3569:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3570: 
 3571:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3572:       // of U over the element.
 3573:       Vector2 U = {0.0, 0.0};
 3574:       for (int m=0; m < elem->i34; m++) {      
 3575:          const Side *side = elem->sides[m];
 3576: 
 3577:          if constexpr(ics == 1) U += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3578:          else                   U += side->frame.project_hvec(side->U, elem->frame);
 3579:       }
 3580:       U = U/elem->i34;
 3581: 
 3582: 
 3583:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3584: 
 3585: 
 3586:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3587:       const double I_4_1 = dot(gradPhi_1, U);
 3588: 
 3589: 
 3590:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3591:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3592: 
 3593:      
 3594:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3595: 
 3596:       // Additional terms 
 3597:       double vnorm = 0.0;
 3598:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3599:          Vector3 ubed = {0.0, 0.0, 0.0};
 3600:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3601: 
 3602:          Vector3 gradP = {0.0, 0.0, 1.0};
 3603:          for (int m=0; m < elem->i34; m++) {
 3604:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3605:            gradP += toVector3(gradP_2D, 0.0);
 3606:          }   
 3607:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3608:       } // imm==2
 3609: 
 3610:       if (elem->isTri()) {
 3611:          for (int l=0; l<3; l++) {
 3612: 
 3613:             Node *node = elem->nodes[l];
 3614: 
 3615:             double fac = (node == node1) ? 2.0 : 1.0;
 3616:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3617:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3618:            
 3619:          }
 3620: 
 3621: 
 3622:          if (!elem->isDry) {
 3623:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3624: 
 3625:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3626: 
 3627:          }
 3628: 
 3629:       } // isTri
 3630:       else { // isQuad
 3631:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3632:          // for (int l=0; l<4; l++) {
 3633:          //   const Node *node = elem->nodes[l];
 3634: 
 3635:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3636:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3637: 
 3638:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3639:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3640:          // }
 3641: 
 3642:       } // isQuad
 3643: 
 3644: 
 3645:      node1->qel += (dt/elem->i34)*elem->vsource;
 3646:       
 3647: 
 3648:    } // for all elements connected to the node
 3649:    
 3650: 
 3651:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3652:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 3653:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3654:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3655:       // If it is an open boundary node...
 3656: 
 3657:       // At least one open bnd side, maybe two
 3658:       for (int l=0; l<2; l++) { 
 3659: 
 3660:          // Gets each of the sides sharing the node. 
 3661:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3662: 
 3663:        
 3664: 
 3665:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3666:          if (sideBnd != nullptr) {
 3667:             // If the side is on a boundary...
 3668: 
 3669:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3670: 
 3671:             // Get the boundary segment
 3672:             const BoundarySegment *sideSegment = sideBnd->segment;
 3673:             const Side *side = sideBnd->side;
 3674: 
 3675:             // Integral I_3
 3676:             if (sideSegment->ifltype != 0) {
 3677:             // Natural or Flather b.c.
 3678: 
 3679:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3680:                // especially for Flather b.c.
 3681:                double ri3 = 0.0;
 3682:                if (!side->isDry) {
 3683:                   // If the side is not dry
 3684:                   
 3685:                   // Computes the side flux of (uth, vth)
 3686:                   double Vn = 0.0;
 3687:                   for (int k = side->kb; k < nvrt - 1; k++) {
 3688:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3689:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3690: 
 3691:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 3692:                   }
 3693: 
 3694:                   ri3 = 0.5*side->len*Vn;
 3695:                }
 3696: 
 3697:                if (sideSegment->ifltype == -1) { // Flather 1
 3698: 
 3699:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3700:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3701: 
 3702:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3703:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3704:                   
 3705:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3706:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3707: 
 3708:                } 
 3709:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3710:                   // Reset ri3
 3711:                   ri3 = 0.0;
 3712: 
 3713:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3714: 
 3715:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3716: 
 3717:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3718:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3719: 
 3720:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3721:                   node1->addToSparseMatrix(node1, con0*2.0);
 3722:                   node1->addToSparseMatrix(node2, con0);
 3723: 
 3724:                } // if Flather or Discharge
 3725: 
 3726:                node1->qel -= thetai*dt*ri3;
 3727: 
 3728: 
 3729:             } // I_3
 3730:           
 3731: 
 3732:             // Integral I_5
 3733:             if(!side->isDry) {
 3734: 
 3735:                const double Unbar = dot(side->U, side->n);
 3736:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3737: 
 3738:             } // I_5
 3739: 
 3740:          } // if is boundary side
 3741: 
 3742:       } // for l
 3743: 
 3744:    } // if isbnd
 3745: 
 3746: 
 3747: }
 3748: 
 3749: 
