 1829: // Helper functions for computing the local node index at a given offset from another.
 1830: __device__ __inline__ int nxq(int offset, int index, int size) {
 1831:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1832:    // to the index to make it positive
 1833:    assert(index + offset + 16*size >= 0);
 1834:    return (index + offset + 16*size) % size;  
 1835: }
 1836: 
 1837: __device__ __inline__ int nxq(int index, int size) {
 1838:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1839:    // to the index to make it positive
 1840:    assert(index + 16*size >= 0);
 1841:    return (index + 16*size) % size; 
 1842: }
