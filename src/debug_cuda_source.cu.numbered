 1227: struct Node {
 1228: 
 1229:    // Geometry information
 1230:    int idx;        // Index of the node
 1231:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1232:    int numNodes;   // Number of nodes neighbors of this node
 1233: 
 1234:    Element **elements; // Array of pointers to the elements that share this node
 1235:    int numElements;    // Number of elements that share this node
 1236: 
 1237:    Side **sides;       // Array of pointers to the sides that are connected to this node.
 1238:    int numSides;       // Number of sides that are connected to this node
 1239: 
 1240: 
 1241:    // XXXXXX I want to keep sides and nodes as separate arrays, for the time being. I have already implemented function nodes2(idx), that should become nodes() eventually.
 1242: 
 1243:    Point2 p;
 1244:    Vector2 u2[nvrt];
 1245:    double  w2[nvrt];
 1246:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1247:    double z[nvrt];
 1248:    double lon, lat;
 1249:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1250:    double depth;
 1251: 
 1252:    int kb;       // Bottom index of the node
 1253: 
 1254:    bool isDry;     // True if the node is dry
 1255: 
 1256:    int iadv;     // Advection flag
 1257: 
 1258:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1259:                           // this is nullptr
 1260: 
 1261:    TempVar tmp; // Temporary variable to store different types of variables
 1262: 
 1263:    // Physical information
 1264:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1265:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1266: 
 1267:    double rho[nvrt];     // Density
 1268:    double dfv[nvrt];     // Vertical viscosity
 1269: 
 1270:    double eta1; // Elevation at nodes at previous timestep
 1271:    double eta2; // Elevation at nodes at current timestep
 1272: 
 1273:    double ETP;  // Earth Tidal Potential
 1274: 
 1275:    double pr;    // Air pressure
 1276:    double grav2; // Gravity 
 1277:    
 1278:    Vector2 dav;  // Depth averaged velocity
 1279: 
 1280:    Vector2 tau; // Wind stress vector
 1281: 
 1282:    // Vegetation parameters
 1283:    double veg_h;
 1284:    double veg_nv;
 1285:    double veg_di;
 1286:    double veg_Cd;
 1287:    double veg_h_unbent;
 1288:    double veg_di_unbent;
 1289:    double veg_nv_unbent;
 1290:    double veg_alpha_vert_mean;
 1291:    double veg_alpha0;
 1292:    double veg_alpha3D[nvrt];
 1293: 
 1294:    // Bottom drag parameters
 1295:    double Cd;       // Bottom drag coefficient   
 1296: 
 1297:    // These three are mutually exclusive
 1298:    union {
 1299:       double rmanning; // Bottom Manning's coefficient
 1300:       double rough;    // Bottom roughness length
 1301:       double drag;     // Bottom drag coefficient
 1302:    };
 1303:    Vector2 tau_bot; // Bottom stress vector
 1304: 
 1305:    double bdef1; // Bottom deformation at previous timestep
 1306:    double bdef2; // Bottom deformation at current timestep
 1307: 
 1308:    double qel; // RHS
 1309:    double coeffDiag; // Diagonal coefficient of the matrix
 1310:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1311: 
 1312:    double mP; // Search direction for conjugate gradient method
 1313:    double mR; // Residual for conjugate gradient method
 1314:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1315:    double mX; // Solution for conjugate gradient method
 1316: 
 1317:    // Meteorological forcing
 1318:    Vector2 u_air;
 1319:    double p_air;
 1320:    double t_air;
 1321:    double q_air;
 1322:    double wind_angle;  // Wind rotation angle
 1323: 
 1324:    __device__ void setWind(Vector2 &u) {
 1325:    // Sets the wind vector taking into account the wind rotation angle
 1326:    
 1327:       const double dir = atan2(-u.x,-u.y);
 1328:       const double speed = length(u);
 1329: 
 1330:       // Calculate new u and v components with added rotation angle
 1331:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1332:    }
 1333: 
 1334: 
 1335:    __inline__ __device__ Node *nodes2(int index) const { index = index % numSides; const Side *side = sides[index]; return side->n1 == this ? side->n2 : side->n1; }
 1336: 
 1337:    __inline__ __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }
 1338: 
 1339:    __device__ double sigmaTransitionDepth(void) const;
 1340: 
 1341:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1342:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1343:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1344:    
 1345:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1346: 
 1347:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1348: 
 1349:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1350:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1351: 
 1352:    __device__ __forceinline__ void clearMatrixRow(void) {
 1353:       // Clear the matrix row for this node
 1354: 
 1355: 
 1356:       coeffDiag = 0.0;
 1357: 
 1358:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1359: 
 1360:    }
 1361: 
 1362:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1363:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1364:       
 1365:       if (node == this) {
 1366:          coeffDiag += value;
 1367:      
 1368:       } else {
 1369:          // Search (linearly)the index of the node in the array of nodes
 1370:          // XXX: This is not efficient, see if we can improve this
 1371:          int i;
 1372:          for (i = 0; i < numNodes; i++) {
 1373:             if (nodes[i] == node) {
 1374:                break;
 1375:             }
 1376:          }
 1377:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1378:          coeffMatrix[i] += value;
 1379:       }
 1380:    }
 1381: 
 1382: 
 1383:    __device__ __inline__ void updateZCoordData(void);
 1384: 
 1385:    __device__ double compZCoord(int k) const;
 1386: 
 1387:    __device__ void updateKb(void);
 1388: 
 1389:    __device__ __forceinline__ void computeBottomDragCd(void);
 1390: 
 1391: 
 1392: 
 1393: };
