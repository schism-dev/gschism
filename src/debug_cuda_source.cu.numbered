 2391: 
 2392: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2393: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2394: __inline__ __device__ double  Side::lon(void) const { return 0.5*(n1->lon + n2->lon); }
 2395: __inline__ __device__ double  Side::lat(void) const { return 0.5*(n1->lat + n2->lat); }
 2396: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2397: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2398:    Vector2 grad = {0.0, 0.0};
 2399:    int count = 0;
 2400: 
 2401:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2402: 
 2403:    // First element
 2404:    if (elems[0] != nullptr && condition(elems[0])) {
 2405:       grad += elems[0]->grad2(field);
 2406:       count++;
 2407:    }
 2408: 
 2409:    // Second element
 2410:    if (elems[1] != nullptr && condition(elems[1])) {
 2411:       grad += elems[1]->grad2(field);
 2412:       count++;
 2413:    }
 2414: 
 2415:    if (count > 0) {
 2416:       grad = grad/count;
 2417:    }
 2418:    
 2419:    return grad;
 2420: }
 2421: 
 2422: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2 + n2->grav2); }
 2423: __inline__ __device__ int     Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 2424: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 2425: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1 + n2->eta1); }
 2426: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); } 
 2427: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2428: 
 2429: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2430: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2431: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2432: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2433: 
 2434: 
 2435: __inline__ __device__ double  Side::Cd(void)      const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2436: 
 2437: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2438: 
 2439: /**
 2440:  * This method performs backtracking from the side center until a time -dt back in time 
 2441:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2442:  * intermediate point.
 2443:  *
 2444:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2445:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2446:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2447:  * remaining time.
 2448:  * 
 2449:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2450:  * 
 2451:  * @param uuint, vvint, wwint: Velocities at the final point
 2452:  * @param jlev: Level at which the backtracking is performed
 2453:  * @param dt, dtbk: Tracking timesteps
 2454:  * @return: True if the backtracking was successful, false otherwise
 2455:  */
 2456: __inline__ __device__ bool Side::btrack(
 2457:       int jlev,
 2458:       double dt,            // Tracking time
 2459:       double dtbk,          // Tracking timestep
 2460:       Vector3 &u_int        // Velocities at the initial point
 2461: ) const {
 2462: 
 2463:    // Start from side center
 2464:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2465: 
 2466:  
 2467:    double time_rm = dt; // Remaining time
 2468: 
 2469: 
 2470:    // // Initialize outputs XXX
 2471:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2472:    //    sclr[i] = 0.0;
 2473:    // }
 2474: 
 2475: 
 2476:    // Initial velocities
 2477:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2478: 
 2479:    // Find the element that is in the direction opposite to the velocity
 2480:    Element* curElem = findElementTowards(toVector2(u_int));
 2481: 
 2482: 
 2483:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2484:    if (curElem == nullptr) {
 2485:       // Make velocity parallel to the side
 2486:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2487:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2488:       curElem = otherElem(curElem);
 2489:       
 2490:    }
 2491: 
 2492: // Nudges it towards the circumcenter
 2493: // printf("0{{jlev = %d}} side->idx = %d, x0 = %.15e,%.15e,%.15e\n", jlev, idx, x0.x, x0.y, x0.z);
 2494: Vector2 xcirc = {(curElem->nodes[0]->p.x + curElem->nodes[1]->p.x + curElem->nodes[2]->p.x)/3.0,
 2495:                  (curElem->nodes[0]->p.y + curElem->nodes[1]->p.y + curElem->nodes[2]->p.y)/3.0};
 2496: const double eps = 9.013e-3;                 
 2497: x0.x = xcirc.x*eps + (1 - eps)*x0.x;
 2498: x0.y = xcirc.y*eps + (1 - eps)*x0.y;
 2499: 
 2500: 
 2501: 
 2502:    const int MAX_ITERATIONS = 1000; 
 2503:    Element* nextElem = curElem;
 2504:    int iter = 0;
 2505:    while(true) {
 2506: 
 2507:       // Calculate timestep
 2508:       double dtb = min(dtbk, time_rm);
 2509: 
 2510:       // Next point in the backtracking curve
 2511:       Point3 xt = x0 - dtb*u_int;
 2512:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2513:       assert(found && "Backtracking failed in btrack");
 2514: 
 2515:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2516: 
 2517:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2518:                       // then time_rm needs to be increased by the unused time.
 2519: 
 2520:       // If the velocity is too small, we stop the backtracking
 2521:       const double vmag = length(toVector2(u_int));
 2522:       if (vmag <= velmin_btrack) break;
 2523: 
 2524:       // The current point becomes the next segment's starting point.
 2525:       x0 = xt;
 2526:  
 2527:       curElem = nextElem;
 2528: 
 2529:       iter++;
 2530:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2531:    }
 2532: 
 2533: 
 2534: }
 2535: 
 2536: 
