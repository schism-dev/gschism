 4326: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4327:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4328:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4329: 
 4330: 
 4331:    NODE(node1);
 4332: 
 4333:    node1->clearMatrixRow();
 4334:    node1->qel = 0.0;
 4335: 
 4336:    // THIS IS FOR STRUCTURES XXX
 4337:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4338: 
 4339:    
 4340:    for (int j=0; j<node1->numElements; j++) {
 4341:       // For each element connected to the node...
 4342: 
 4343:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 4344: 
 4345:       Element *elem = node1->elements[j];
 4346: 
 4347:       // Compute the average gravity
 4348:       const double grav3 = elem->mean(&Node::grav2);
 4349: 
 4350:       // Look at the documentation for the description of the terms in the following integrals
 4351: 
 4352:       // Integral I_1 
 4353:       // \bar{\breve{H}} 
 4354:       const double hhatb = elem->mean(&Side::hhat);        
 4355: 
 4356:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4357: 
 4358:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 4359:       const double area = elem->area;
 4360: 
 4361:       // Integral I_4
 4362:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4363:       // Where
 4364:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4365: 
 4366:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4367:       // of U over the element.
 4368:       const Vector2 U = elem->mean(&Side::U);
 4369: 
 4370:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4371: 
 4372:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4373:       const double I_4_1 = dot(gradPhi_1, U);
 4374: 
 4375: 
 4376:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4377:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4378: 
 4379:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4380: 
 4381: 
 4382:       // Normal component of the bed velocity
 4383:       double ubedNormalComp = 0.0;
 4384:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4385:          Vector3 ubed = {0.0, 0.0, 0.0};
 4386:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4387:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4388: 
 4389:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 4390:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 4391:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 4392: 
 4393:          // Computes the normal component of the bed velocity
 4394:          ubedNormalComp = dot(ubed, N);
 4395:       } // imm==2
 4396: 
 4397:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 4398: 
 4399:       if (elem->isTri()) {
 4400: 
 4401:          // To clarify the notation in this section: 
 4402:          //   In formulas, we use the following notation:
 4403:          //       i stands for the node under consideration (node1)
 4404:          //       j (node2) and k (node3) are the other nodes of the triangle.
 4405:          //   However, in the code, we use the following notation:
 4406:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 4407:          const int id2 = elem->nxq(1 + id1);
 4408:          const int id3 = elem->nxq(2 + id1);
 4409:          Node *node2 = elem->nodes[id2];
 4410:          Node *node3 = elem->nodes[id3];
 4411: 
 4412:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 4413: 
 4414:          // integral of phi_i*phi_j
 4415:          const double ipp_ii = (1.0/6.0 )*area;
 4416:          const double ipp_ij = (1.0/12.0)*area;
 4417:          const double ipp_ik = (1.0/12.0)*area;
 4418: 
 4419:          // integral of [(grad phi_i) * (grad phi_j)]
 4420:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 4421:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 4422:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 4423: 
 4424:          // Computes the different components of integral I_1 of each node with respect to node i.
 4425:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4426:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4427:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4428: 
 4429:          node1->addToSparseMatrix(node1, I1_ii);
 4430:          node1->addToSparseMatrix(node2, I1_ij); 
 4431:          node1->addToSparseMatrix(node3, I1_ik);
 4432: 
 4433:          #pragma unroll
 4434:          for (int l=0; l<3; l++) {
 4435: 
 4436:             Node *node = elem->nodes[l];
 4437: 
 4438:             // Additional variation in eta due to bed deformation or vertical velocity
 4439:             double extraEta = 0.0;
 4440:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4441:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 4442: 
 4443: 
 4444:             const double ipp   = elem->intPhiPhiTri(id1, l);
 4445:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 4446: 
 4447:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 4448: 
 4449:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 4450:            
 4451:          }
 4452: 
 4453: 
 4454:       }
 4455:       else { // Quad
 4456:          // To clarify the notation in this section: 
 4457:          //   In formulas, we use the following notation:
 4458:          //       i stands for the node under consideration (node1)
 4459:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 4460:          //   However, in the code, we use the following notation:
 4461:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 4462:          const int id2 = elem->nxq(1 + id1);
 4463:          const int id3 = elem->nxq(2 + id1);
 4464:          const int id4 = elem->nxq(3 + id1);
 4465:          Node *node2 = elem->nodes[id2];
 4466:          Node *node3 = elem->nodes[id3];
 4467:          Node *node4 = elem->nodes[id4];   
 4468:          
 4469:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 4470: 
 4471:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4472:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 4473:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 4474:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 4475:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 4476: 
 4477:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4478:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 4479:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 4480:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 4481:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 4482: 
 4483: 
 4484:          // Computes the different components of integral I_1 of each node with respect to node i.
 4485:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4486:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4487:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4488:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4489: 
 4490:          node1->addToSparseMatrix(node1, I1_ii);
 4491:          node1->addToSparseMatrix(node2, I1_ij); 
 4492:          node1->addToSparseMatrix(node3, I1_ik);
 4493:          node1->addToSparseMatrix(node4, I1_il);
 4494:   
 4495:          #pragma unroll
 4496:          for (int l=0; l<4; l++) {
 4497: 
 4498:             const Node *node = elem->nodes[l];
 4499: 
 4500:             // Additional variation in eta due to bed deformation or vertical velocity
 4501:             double extraEta = 0.0;
 4502:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4503:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 4504: 
 4505:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 4506:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 4507:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 4508: 
 4509:          }         
 4510:       } 
 4511: 
 4512: 
 4513:      node1->qel += (dt/elem->i34)*elem->vsource;
 4514:       
 4515: 
 4516:    } // for all elements connected to the node
 4517:    
 4518: 
 4519:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4520:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4521:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4522:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4523:    // If it is an open boundary node...
 4524: 
 4525:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 4526: 
 4527:       // At least one open bnd side, maybe two
 4528:       for (int l=0; l<2; l++) { 
 4529: 
 4530:          // Gets each of the sides sharing the node. 
 4531:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4532: 
 4533:     
 4534: 
 4535:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4536:          if (sideBnd != nullptr) {
 4537:             // If the side is on a boundary...
 4538: 
 4539:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4540: 
 4541:             // Get the boundary segment
 4542:             const BoundarySegment *sideSegment = sideBnd->segment;
 4543:             const Side *side = sideBnd->side;
 4544: 
 4545:             // Integral I_3
 4546:             if (sideSegment->ifltype != 0) {
 4547:             // Natural or Flather b.c.
 4548: 
 4549:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4550:                // especially for Flather b.c.
 4551:                double ri3 = 0.0;
 4552:                if (!side->isDry) {
 4553:                   // If the side is not dry
 4554:                   
 4555:                   // Computes the side flux of (uth, vth)
 4556:                   double Vn = 0.0;
 4557:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4558:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4559:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4560: 
 4561:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4562:                   }
 4563: 
 4564:                   ri3 = 0.5*side->len*Vn;
 4565:                }
 4566: 
 4567:                if (sideSegment->ifltype == -1) { // Flather 1
 4568: 
 4569:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4570:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4571: 
 4572:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4573:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4574:                   
 4575:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4576:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4577: 
 4578:                } 
 4579:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4580:                   // Reset ri3
 4581:                   ri3 = 0.0;
 4582: 
 4583:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4584:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4585: 
 4586:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4587: 
 4588:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4589:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4590: 
 4591:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4592:                   node1->addToSparseMatrix(node1, con0*2.0);
 4593:                   node1->addToSparseMatrix(node2, con0);
 4594: 
 4595:                } // if Flather or Discharge
 4596: 
 4597:                node1->qel -= thetai*dt*ri3;  
 4598: 
 4599: 
 4600:             } // I_3
 4601:           
 4602: 
 4603:             // Integral I_5
 4604:             if(!side->isDry) {
 4605: 
 4606:                const double Unbar = dot(side->U, side->n);
 4607:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 4608: 
 4609:             } // I_5
 4610: 
 4611:          } // if is boundary side
 4612: 
 4613:       } // for l
 4614: 
 4615:    } // if isbnd
 4616: 
 4617: 
 4618: }
 4619: 
 4620: 
 4621: 
 4622: extern "C" {
 4623:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4624:                                   int* indices, int* indptr) {
 4625: 
 4626:       NODE(node);
 4627:       
 4628:       const int idx = node->idx;
 4629:       
 4630:       // Computes the index in the nzz array      
 4631:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4632: 
 4633: 
 4634:       indptr[idx] = nzzIdx;
 4635:       indices[nzzIdx] = idx;
 4636: 
 4637:       data_d[nzzIdx]    = node->coeffDiag;
 4638: 
 4639:       b_d[idx] = node->qel;
 4640: 
 4641:       for (int k = 0; k < node->numNodes; ++k) {
 4642:          const Node* nb = node->nodes[k];
 4643: 
 4644:          const int j = nb->idx;
 4645: 
 4646:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4647: 
 4648:          indices[nzzIdx + k + 1] = j;
 4649:       }
 4650: 
 4651:  
 4652:    }
 4653: 
 4654: 
 4655: 
 4656:    __global__ void solverCopyResult(double* x) {
 4657:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4658:       NODE(node);
 4659:       const int idx = node->idx;
 4660: 
 4661:       node->mX = x[idx];
 4662:    }
 4663: 
 4664: 
 4665:    __global__ void rollUpElevation(void) {
 4666: 
 4667:       NODE(node);
 4668: 
 4669:       node->eta1 = node->eta2;
 4670: 
 4671:    }
 4672: 
 4673: 
 4674:    __global__ void backtrackAllNodes(void) {
 4675: 
 4676:       // max/min # of sub-divisions
 4677:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4678:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4679: 
 4680:       SIDE(side);
 4681: 
 4682:       const int kb = side->kb;
 4683: 
 4684: 
 4685:       // Initialize btrack velocities to the actual velocities at the side 
 4686:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4687:   
 4688:       if (side->isDry) return;
 4689:      
 4690: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4691: 
 4692:       // Checks that at least one element is not dry
 4693:       const Element *elem1 = side->elems[0];
 4694:       const Element *elem2 = side->elems[1];
 4695: 
 4696: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4697: 
 4698:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4699:       
 4700:       // XXXXXX
 4701:       // !swild_tmp to store global coord. of the starting side
 4702:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4703:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4704:       // !Use sframe2 
 4705:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4706: 
 4707: 
 4708:       for (int k = kb; k < nvrt; k++) {
 4709:       //  Initialize (xt,yt,zt), nnel and vel.
 4710:       //  For ics=2, the coordinates are all in the side's local frame
 4711:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4712: 
 4713:          const int iadvf = side->iadv();  // Advection flag   
 4714:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4715: 
 4716:          const double vmag2 = norm2(side->u2[k]);
 4717: 
 4718:          if (vmag2 <= velmin_btrack_sq) {  // XXXXXX REPEATED?
 4719:             // No activity 
 4720: 
 4721:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4722: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4723: 
 4724:             
 4725:          } else {  // do btrack
 4726: 
 4727:             // Compute number of sub-divisions based on local gradients of the velocity field
 4728: 
 4729:             // XXX IS THIS NECESSARY?
 4730:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4731:             double suma = 0.0;
 4732:             int icount = 0;
 4733:             for (int l=0; l<2; l++) {
 4734:             // For each element sharing the side...
 4735: 
 4736:                const Element *elem = side->elems[l];
 4737:                  
 4738:                if (elem == nullptr) continue;
 4739: 
 4740:                icount++;
 4741: 
 4742:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4743:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4744:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4745: 
 4746:                double utmp[4];
 4747:                double vtmp[4];
 4748:                for (int j = 0; j < elem->i34; j++) {
 4749: 
 4750:                   const Node *node = elem->nodes[j];
 4751: 
 4752:                   if constexpr(ics==1) {
 4753:                      utmp[j] = node->u2[k].x;
 4754:                      vtmp[j] = node->u2[k].y;  
 4755: 
 4756:                   } else {
 4757:                      // 'Project' the velocity from the node frame to the element frame
 4758:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4759:                      utmp[j] = tmp_u2.x;
 4760:                      vtmp[j] = tmp_u2.y;
 4761: 
 4762:                   }
 4763:                } // for j
 4764: 
 4765:                const Vector2 grad_u = elem->grad2(utmp); 
 4766:                const Vector2 grad_v = elem->grad2(vtmp);
 4767:    
 4768:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4769:             } // for ii
 4770: 
 4771:             assert(icount > 0 && "Impossible 77");
 4772: 
 4773:             // '4' is somewhat arbitrary
 4774:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4775: 
 4776:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4777:             Vector3 u_int = {0.0, 0.0, 0.0};
 4778: 
 4779:             side->btrack(k, dt, dtbk, u_int);
 4780: 
 4781: 
 4782:             side->btu[k] = {u_int.x, u_int.y};
 4783:                
 4784:          } // if vmag (do backtrack)
 4785: 
 4786: 
 4787:       } // for k=kb,nvrt-1
 4788: 
 4789:    }
 4790: 
 4791: } // extern "C"
 4792: 
 4793: template<int nc>
 4794: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4795: 
 4796: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4797: //
 4798: // a,b,c,rhs: input vectors and are not modified by this program.
 4799: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4800: // rhs is the r.h.s.
 4801: // n: actual rank of the system.
 4802: // rows in u() and rhs();
 4803: // u: output with nc columns (transposed to rows)
 4804: // gam: a working array.
 4805: //
 4806: // NOTES:
 4807: // This is a template function that allows for different numbers of columns in the rhs vector.
 4808: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4809: 
 4810:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4811:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4812: 
 4813:    double bet = b[0];
 4814:    if constexpr (nc == 1) {
 4815:       u[0] = rhs[0]/bet;
 4816:    } else {
 4817:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4818:    }
 4819: 
 4820:    for (int j = 1; j < n; j++) {
 4821:       gam[j] = c[j - 1]/bet;
 4822:       bet = b[j] - a[j]*gam[j];
 4823: 
 4824:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4825: 
 4826:       if constexpr (nc == 1) {
 4827:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4828:       } else {
 4829:          for (int l = 0; l < nc; l++) {
 4830:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4831:          }
 4832:       }
 4833:    }
 4834: 
 4835:    // Back-substitution
 4836:    for (int j = n - 2; j >= 0; j--) {
 4837:       if constexpr (nc == 1) {
 4838:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4839:       } else {
 4840:          for (int l = 0; l < nc; l++) {
 4841:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4842:          }
 4843:       }
 4844:    }
 4845: }
 4846: 
 4847: 
 4848: 
 4849: // Helper function that contains the core algorithm
 4850: template<typename XAccessor, typename YAccessor>
 4851: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4852:                                     double  yp_top, double  yp_bot, 
 4853:                                     CubicSpline &spline) {
 4854:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4855:    // 
 4856:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4857:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4858:    //
 4859:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4860:    // 
 4861:    // Inputs: 
 4862:    //            n: dimension for x etc; # of data pts (>=2);
 4863:    //            getX, getY: functions to access x,y coordinates
 4864:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4865:    //     Output: 
 4866:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4867: 
 4868:    const int n = k2 - k1 + 1;
 4869:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4870: 
 4871:    // Allocate memory for the splines
 4872:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4873:    spline.x   = new double[n];
 4874:    spline.y   = new double[n];
 4875:    spline.yp  = new double[n];
 4876:    spline.ypp = new double[n];
 4877: 
 4878:    for (int k=k1; k<=k2; k++) {
 4879:       spline.x[k] = getX(k);
 4880:       spline.y[k] = getY(k);
 4881:    }
 4882: 
 4883:    // This is to simplify expressions later
 4884:    double *x = spline.x;
 4885:    double *y = spline.y;
 4886: 
 4887:    double *a = nullptr;
 4888:    double *b = nullptr;
 4889:    double *c = nullptr;
 4890:    double *gam = nullptr;
 4891:    double *rhs = nullptr;
 4892:    
 4893: 
 4894:       a = new double[n];   // Lower diagonal
 4895:       b = new double[n];   // Diagonal
 4896:       c = new double[n];   // Upper diagonal
 4897:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4898:       rhs = new double[n]; // Right-hand side
 4899: 
 4900:    for (int k=k1; k<=k2; k++) {
 4901:       if (k == k1) {
 4902:          // Bottom level
 4903:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4904:          b[k] = (x[k+1] - x[k])/3.0;
 4905:          c[k] = b[k]/2.0;
 4906:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4907:       } else if (k == n - 1) {
 4908:          // Top level (surface)
 4909:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4910:          b[k] = (x[k] - x[k-1])/3.0;
 4911:          a[k] = b[k]/2.0;
 4912:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4913:       } else {
 4914:          // Intermediate levels
 4915:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4916:          b[k] = (x[k+1] - x[k-1])/3.0;
 4917:          a[k] = (x[k  ] - x[k-1])/6.0;
 4918:          c[k] = (x[k+1] - x[k  ])/6.0;
 4919:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4920:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4921:       }
 4922:    }
 4923: 
 4924:    // Solve the tridiagonal system
 4925:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4926:    
 4927:    spline.yp[k1] = yp_bot;
 4928:    spline.yp[k2] = yp_top;
 4929: 
 4930:    // Compute rest of 1st derivatives using the splines
 4931:    for (int k=k1+1; k<k2; k++) {
 4932:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4933:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4934:    }
 4935:    
 4936:    delete[] a;
 4937:    delete[] b;
 4938:    delete[] c;
 4939:    delete[] gam;
 4940:    delete[] rhs;
 4941: 
 4942: }
 4943: 
 4944: // Array version
 4945: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4946:                                 double y_top, double y_bot, 
 4947:                                 CubicSpline &spline) {
 4948:    auto getX = [x] (int k) { return x[k]; };
 4949:    auto getY = [y] (int k) { return y[k]; };
 4950:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4951: }
 4952: 
 4953: // Lambda version - allows custom access patterns
 4954: template<typename XFunc, typename YFunc>
 4955: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4956:                                 double y_top, double y_bot,
 4957:                                 CubicSpline &spline) {
 4958:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4959: }
