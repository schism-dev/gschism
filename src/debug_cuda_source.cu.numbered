 2302: __device__ void lock(int *mutex) {
 2303:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2304: }
 2305: 
 2306: __device__ void unlock(int *mutex) {
 2307:     atomicExch(mutex, 0);
 2308: }
