 2636: 
 2637: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2638: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2639: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2640: // Only when ics == 2, the origin is at the element center.
 2641: 
 2642:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2643: 
 2644:    const Node *node = nodes[idxNode];
 2645: 
 2646:    if constexpr(ics==1) {
 2647:       return node->p;
 2648: 
 2649:    } else {
 2650:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2651: 
 2652:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2653: 
 2654:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2655:    }
 2656: 
 2657: }
 2658: 
 2659: 
 2660: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, 
 2661:                                                                             const Vector3& c, const Frame<ics>& dstFrame, int idx) const {
 2662: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2663: 
 2664:    const int id1 = idx;
 2665:    const int id2 = nxq(1 + id1);
 2666:    const int id3 = nxq(2 + id1);
 2667: 
 2668:    if constexpr(ics==1) {
 2669:       x0 = nodes[id1]->p;
 2670:       x1 = nodes[id2]->p;
 2671:       x2 = nodes[id3]->p;
 2672: 
 2673:    } else {
 2674: 
 2675:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2676:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2677:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2678: 
 2679:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2680:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2681:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2682: 
 2683:    }
 2684: 
 2685: }
 2686: 
 2687: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2688:    getLocalHorizontalNodePositionsTri(x0, x1, x2, {center.x, center.y, centerZ()}, frame, idx);
 2689: }
 2690: 
 2691: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2692:             Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 2693:             const Vector3& c, const Frame<ics>& dstFrame) const {
 2694: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2695: 
 2696:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2697: 
 2698: 
 2699: 
 2700:    if constexpr(ics==1) {
 2701:       x0 = nodes[0]->p;
 2702:       x1 = nodes[1]->p;
 2703:       x2 = nodes[2]->p;  
 2704:       x3 = nodes[3]->p;
 2705: 
 2706:    } else {
 2707: 
 2708:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2709:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2710:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2711:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2712: 
 2713:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2714:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2715:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2716:       x3 = toVector2(dstFrame.G2L(p3 - c));
 2717:    }
 2718: 
 2719: }
 2720: 
 2721: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2722:    Point2& x0, Point2& x1, Point2& x2, Point2& x3) const
 2723: {
 2724:    getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, {center.x, center.y, centerZ()}, frame);
 2725: }
